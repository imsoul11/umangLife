# Copy to .env.local and fill in. NEVER commit .env.local.

# Pick provider: "gemini" (free tier) or "openai"
AI_PROVIDER=gemini

# Gemini — get a key at https://aistudio.google.com
GEMINI_API_KEY=

# OpenAI fallback (only if AI_PROVIDER=openai)
OPENAI_API_KEY=

# Optional override; defaults: gemini-3.6-flash / gpt-4o-mini
AI_MODEL=

# Hosted persistence (optional). Set DATABASE_URL (Neon / Vercel Postgres) to
# store sessions in Postgres instead of the local SQLite file (.data/umang.db).
DATABASE_URL=

# Optional email digest (Resend). When set, POST /api/digest emails the SLA
# summary to SLA_DIGEST_TO; without them the endpoint just returns a preview.
RESEND_API_KEY=
SLA_DIGEST_TO=
